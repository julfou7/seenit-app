{
  "name": "seenit-app",
  "private": true,
  "version": "1.4.116",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "postinstall": "node scripts/patch-local-notifications.cjs && node scripts/materialize-android-config.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node scripts/clean.cjs",
    "lint": "tsc --noEmit",
    "test": "npm run test:spec && npm run test:android && npm run lint && npm run test:unit",
    "test:unit": "node --test tests/*.test.ts",
    "test:spec": "node scripts/validate-specifications.cjs",
    "test:android": "node scripts/validate-android-contract.cjs",
    "test:spec:changes": "node scripts/validate-change-contract.cjs",
    "delivery:classify": "node scripts/classify-delivery.cjs",
    "test:plex": "npm run test:spec && npm run test:unit",
    "version:sync": "node scripts/sync-app-version.cjs",
    "release:status": "node scripts/release-status.cjs",
    "release:prepare": "node scripts/prepare-release.cjs",
    "release:prepare:files": "node scripts/prepare-release-files.cjs",
    "release:dispatch": "node scripts/dispatch-release.cjs"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor-firebase/authentication": "^8.4.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/local-notifications": "^8.3.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "papaparse": "^5.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "brace-expansion@2.1.2": "2.1.4",
    "gaxios": {
      "uuid": "11.1.1"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    },
    "xcode": {
      "uuid": "11.1.1"
    },
    "esbuild@<=0.24.2": "0.25.0",
    "nanoid@<3.3.18": "3.3.18",
    "postcss@<=8.5.22": "8.5.23",
    "sharp@<0.35.0": "0.35.0",
    "tar@<=7.5.20": "7.5.21"
  }
}

# URL publique canonique du backend SeenIt.
# Utilisée pour générer les URL personnelles Sonarr/Radarr derrière un proxy.
# En production, le fallback reste https://seenit.ai.studio.
PUBLIC_APP_URL=

# Secrets fournisseurs exclusivement côté backend SeenIt.
# Ne jamais créer de variante VITE_* ni recopier ces valeurs dans le frontend, les logs ou GitHub.
TMDB_API_KEY=
OMDB_API_KEY=
TVDB_API_KEY=

# Jeton GitHub optionnel pour consulter les mises à jour d'un dépôt privé.
GITHUB_PAT=

# Les webhooks Sonarr/Radarr n'utilisent plus de WEBHOOK_SECRET global.
# SeenIt génère pour chaque utilisateur un endpoint et un secret personnels depuis l'interface.
# Le secret personnel doit être envoyé dans l'en-tête HTTP suivant :
#   x-seenit-webhook-secret: <secret personnel>
# Les URL ont la forme :
#   https://<backend>/api/webhook/sonarr/<endpointId>
#   https://<backend>/api/webhook/radarr/<endpointId>
